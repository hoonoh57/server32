# Repository text files are already stored as UTF-8.
# Do not apply working-tree-encoding=UTF-8: on Git for Windows it can make
# UTF-8/BOM files appear modified immediately after checkout or reset.
* text=auto
*.vb text
*.vbproj text
*.sln text
*.config text
*.xml text
*.json text
*.md text
*.ps1 text
*.bat text
